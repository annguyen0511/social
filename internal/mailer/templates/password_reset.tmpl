{{define "subject"}}Reset your Social Network password{{end}}

{{define "plainBody"}}
Hi {{.Username}},

Someone asked to reset the password for your Social Network account. Open the
link below to choose a new one:

{{.ActionURL}}

The link expires soon and can only be used once.

If this was not you, nothing has changed and you can ignore this message. Your
current password still works.
{{end}}

{{define "htmlBody"}}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:24px;background:#f5f5f4;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#1c1917;">
  <div style="max-width:480px;margin:0 auto;background:#ffffff;border-radius:12px;padding:32px;">
    <h1 style="margin:0 0 16px;font-size:20px;">Reset your password</h1>
    <p style="margin:0 0 24px;line-height:1.6;color:#44403c;">
      Hi {{.Username}}, someone asked to reset the password for your Social Network account.
      Choose a new one with the button below.
    </p>
    <p style="margin:0 0 24px;">
      <a href="{{.ActionURL}}" style="display:inline-block;background:#1c1917;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:600;">Choose a new password</a>
    </p>
    <p style="margin:0 0 8px;line-height:1.6;color:#78716c;font-size:13px;">
      If the button does not work, paste this address into your browser:
    </p>
    <p style="margin:0 0 24px;word-break:break-all;font-size:13px;color:#78716c;">{{.ActionURL}}</p>
    <p style="margin:0;line-height:1.6;color:#78716c;font-size:13px;">
      The link expires soon and works only once. If this was not you, nothing has changed
      and your current password still works.
    </p>
  </div>
</body>
</html>
{{end}}
